# 统一换行符，消除 Windows/Linux 协作时的 CRLF 噪音
# 文本文件一律以 LF 存入仓库，检出时按各平台习惯还原
* text=auto eol=lf

# 显式声明为文本
*.ts    text
*.tsx   text
*.js    text
*.jsx   text
*.json  text
*.css   text
*.html  text
*.md    text
*.yml   text
*.yaml  text

# Windows 专用脚本保留 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件：不参与换行符转换，且不计入语言统计
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.exe   binary
*.dll   binary
*.zip   binary

# 锁文件在 PR 文件列表与语言统计中折叠，但仍保留可读 diff
# （不用 -diff：那会把 lock 当二进制，依赖变动将无法在 review 中查看）
package-lock.json  linguist-generated=true -linguist-detectable
